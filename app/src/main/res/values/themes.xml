<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Shizutify" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg_alabaster</item>
        <item name="colorPrimary">@color/primary_terracotta</item>
        <item name="colorOnPrimary">@color/surface_cream</item>
        <item name="colorSurface">@color/surface_cream</item>
        <item name="colorOnSurface">@color/espresso_brown</item>
        <item name="colorSecondaryContainer">@color/accent_peach</item>
        <item name="colorOnSecondaryContainer">@color/espresso_brown</item>

        <!-- Edge-to-edge transparent system bars with dark status icons -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>
</resources>